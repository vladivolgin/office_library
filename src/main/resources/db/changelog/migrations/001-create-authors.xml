<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-authors" author="dev">
        <createTable tableName="authors"
                     remarks="Таблица авторов книг">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="full_name" type="VARCHAR(255)"
                    remarks="ФИО автора (обязательное)">
                <constraints nullable="false"/>
            </column>

            <column name="birth_year" type="INTEGER"
                    remarks="Год рождения автора">
                <constraints nullable="true"/>
            </column>

            <column name="biography" type="TEXT"
                    remarks="Биография автора">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>

</databaseChangeLog>
