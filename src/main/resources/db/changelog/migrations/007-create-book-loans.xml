<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-create-book-loans" author="dev">
        <createTable tableName="book_loans"
                     remarks="История выдачи книг (кто и когда взял/сдал)">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="book_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_book_loans_book"
                             references="books(id)"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_book_loans_user"
                             references="users(id)"/>
            </column>

            <column name="taken_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="returned_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <createIndex indexName="idx_book_loans_book_id" tableName="book_loans">
            <column name="book_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
