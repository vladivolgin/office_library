<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-users" author="dev">
        <createTable tableName="users"
                     remarks="Таблица пользователей системы">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="full_name" type="VARCHAR(255)"
                    remarks="ФИО пользователя (обязательное)">
                <constraints nullable="false"/>
            </column>

            <column name="birth_year" type="INTEGER"
                    remarks="Год рождения пользователя">
                <constraints nullable="true"/>
            </column>

            <column name="role" type="VARCHAR(20)"
                    remarks="Роль: READER или EDITOR">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Индекс для быстрого поиска по роли -->
        <createIndex indexName="idx_users_role" tableName="users">
            <column name="role"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
